  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "smoke-checklist": "node -e \"console.log(['Device smoke checklist — AIB Camera','1. Grant camera + location on a physical device','2. Confirm live stamp updates time/coords/address','3. Capture outdoors; verify stamp burned into JPEG','4. Confirm EXIF GPS present in Photos/Files metadata','5. Save → album AIB Camera appears','6. Share via system sheet (WhatsApp/Mail)','7. Toggle stamp settings and retake','8. Airplane mode: photo still saves; address fallback text','9. iOS 26+: Liquid Glass controls; older: blur fallback','10. Swipe left from camera opens gallery'].join('\\n'))\""
  },
  "private": true,
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true
  }
