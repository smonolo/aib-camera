{
  "expo": {
    "name": "AIB Camera",
    "slug": "aib-camera",
    "version": "1.3.0",
    "orientation": "default",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "scheme": "aibcamera",
    "userInterfaceStyle": "automatic",
    "description": "Fotocamera indipendente per chiunque: scatta foto e registra video geolocalizzati di incendi boschivi (AIB) con data, ora, GPS e luogo stampati sul JPEG o sul video. Funziona offline; la posizione è opzionale. Non riservata a enti o professionisti.",
    "primaryColor": "#F5F5F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.smnl.aibcamera",
      "buildNumber": "20",
      "infoPlist": {
        "NSCameraUsageDescription": "AIB Camera usa la fotocamera per scattare foto e registrare video con data, ora e posizione per attività di antincendio boschivo.",
        "NSMicrophoneUsageDescription": "AIB Camera usa il microfono per registrare l’audio nei video. Puoi registrare anche senza microfono.",
        "NSLocationWhenInUseUsageDescription": "AIB Camera usa la tua posizione GPS per stampare coordinate, altitudine, direzione e luogo sulla foto o sul video.",
        "NSPhotoLibraryAddUsageDescription": "AIB Camera salva le foto e i video timbrati nell'album AIB Camera.",
        "NSPhotoLibraryUsageDescription": "AIB Camera può accedere alla libreria Foto per salvare e rimuovere le foto e i video scattati con l'app."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ]
      }
    },
    "android": {
      "package": "dev.smnl.aibcamera",
      "versionCode": 11,
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "backgroundColor": "#AF2525",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.READ_MEDIA_AUDIO"],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "backgroundColor": "#F5F5F5",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#111111"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AIB Camera usa la fotocamera per scattare foto e registrare video con data, ora e posizione.",
          "microphonePermission": "AIB Camera usa il microfono per registrare l’audio nei video. Puoi registrare anche senza microfono.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AIB Camera usa la tua posizione GPS per stampare coordinate, altitudine, direzione e luogo sulla foto o sul video."
        }
      ],
      "expo-screen-orientation",
      [
        "expo-media-library",
        {
          "photosPermission": "AIB Camera può salvare e rimuovere le foto e i video timbrati nell'album AIB Camera.",
          "savePhotosPermission": "AIB Camera salva le foto e i video con timbro nell'album AIB Camera.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo", "video"]
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-font",
      "expo-status-bar",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-web-browser",
      "expo-video",
      "react-native-video-pipeline"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://aib.smnl.dev/camera/privacy",
      "termsOfUseUrl": "https://aib.smnl.dev/camera/terms",
      "userGuideUrl": "https://aib.smnl.dev/camera/guide",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "1f4f7de2-f8af-4cb7-b705-5af738d4c11a"
      }
    },
    "owner": "smnl"
  }
}
