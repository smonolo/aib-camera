{
  "expo": {
    "name": "AIB Camera",
    "slug": "aib-camera",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aibcamera",
    "userInterfaceStyle": "automatic",
    "description": "Fotocamera indipendente per chiunque: scatta foto geolocalizzate di incendi boschivi (AIB) con data, ora, GPS e luogo stampati sul JPEG. Funziona offline; la posizione è opzionale. Non riservata a enti o professionisti.",
    "primaryColor": "#F5F5F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.smnl.aibcamera",
      "buildNumber": "11",
      "infoPlist": {
        "NSCameraUsageDescription": "AIB Camera usa la fotocamera per scattare foto con data, ora e posizione per attività di antincendio boschivo.",
        "NSLocationWhenInUseUsageDescription": "AIB Camera usa la tua posizione GPS per stampare coordinate, altitudine, direzione e luogo sulla foto.",
        "NSPhotoLibraryAddUsageDescription": "AIB Camera salva le foto con timbro nell'album AIB Camera.",
        "NSPhotoLibraryUsageDescription": "AIB Camera può accedere alla libreria Foto per salvare e rimuovere le foto scattate con l'app."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ]
      }
    },
    "android": {
      "package": "dev.smnl.aibcamera",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "backgroundColor": "#F5F5F5",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#111111"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AIB Camera usa la fotocamera per scattare foto con data, ora e posizione.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AIB Camera usa la tua posizione GPS per stampare coordinate, altitudine, direzione e luogo sulla foto."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AIB Camera può salvare e rimuovere le foto timbrate nell'album AIB Camera.",
          "savePhotosPermission": "AIB Camera salva le foto con timbro nell'album AIB Camera.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-font",
      "expo-status-bar",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://smnl.dev/aib-camera/privacy",
      "termsOfUseUrl": "https://smnl.dev/aib-camera/terms",
      "userGuideUrl": "https://smnl.dev/aib-camera/guida"
    }
  }
}
